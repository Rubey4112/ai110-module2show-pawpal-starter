classDiagram
    class Owner {
        +String name
        +String availableTime
        +List~Pet~ pets
    }

    class Pet {
        +String name
        +String species
        +List~Task~ tasks
    }

    class Task {
        +String name
        +int duration
        +int priority
        +bool isRecurring
        +markComplete() void
    }

    class Scheduler {
        +generatePlan(owner: Owner) List~Task~
    }

    Owner "1" *-- "many" Pet : owns
    Pet "1" *-- "many" Task : has
    Scheduler ..> Owner : uses
